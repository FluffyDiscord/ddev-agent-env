    tmp="$file.tmp.$$"
    if ! awk 'NR==1 && /#ddev-generated/ {next} {print}' "$file" >"$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    mv -f "$tmp" "$file"
}

# Router hostnames are machine-wide: rebase the parent's onto the clone so they don't collide.
listRebasedHostnames() {
    local target=$1
    python3 -c '
import sys, yaml

target, parent = sys.argv[1], sys.argv[2]
hostnames = []

for path in sys.argv[3:]:
    try:
        document = yaml.safe_load(open(path)) or {}
    except Exception:
        continue
    if not isinstance(document, dict) or not isinstance(document.get("additional_hostnames"), list):
        continue
    if document.get("override_config") is True:
        hostnames = []
    hostnames += [str(name) for name in document["additional_hostnames"] if str(name) not in hostnames]

for name in hostnames:
    labels = name.split(".")
    if name == parent:
        rebased = target
    elif parent in labels:
        rebased = ".".join(target if label == parent else label for label in labels)
    elif name.startswith(parent + "-"):
        rebased = target + name[len(parent):]
    else:
        rebased = target + "-" + name
    print(name + "\t" + rebased)
' "$target" "$DDEV_PROJECT" "$DDEV_APPROOT/.ddev/config.yaml" "$DDEV_APPROOT"/.ddev/config.*.yaml
}

listEnvHostRewrites() {
    local target=$1 tld=${DDEV_TLD:-ddev.site} sourceName rebasedName
    printf '%s\t%s\n' "$(getSourceHost)" "$target.$tld"
    while IFS=$'\t' read -r sourceName rebasedName; do
        case "$sourceName" in *'*'*) continue ;; esac
        printf '%s\t%s\n' "$sourceName.$tld" "$rebasedName.$tld"
    done < <(listRebasedHostnames "$target")
}

writeCloneConfig() {
    local worktree=$1 target=$2

    if [ -f "$DDEV_APPROOT/.ddev/.gitignore" ]; then
        cp -a "$DDEV_APPROOT/.ddev/.gitignore" "$worktree/.ddev/.gitignore"
        stripDdevGeneratedFirstLine "$worktree/.ddev/.gitignore"
    fi

    local quotedHostnames
    quotedHostnames=$(listRebasedHostnames "$target" | awk -F'\t' '{printf "%s\"%s\"", (NR > 1 ? ", " : ""), $2}')
    printf 'override_config: true\nname: "%s"\nfail_on_hook_fail: true\nadditional_hostnames: [%s]\nadditional_fqdns: []\n' \
        "$target" "$quotedHostnames" >"$worktree/.ddev/$CLONE_CONFIG_FILE" \
        || fail $EXIT_WRITE "cannot write $CLONE_CONFIG_FILE"

    cat >"$worktree/.ddev/docker-compose.agentgit.yaml" <<YAML || fail $EXIT_WRITE "cannot write docker-compose.agentgit.yaml"
services:
  web:
    volumes:
      - $DDEV_APPROOT/.git:$DDEV_APPROOT/.git
YAML

    appendGitignoreEntry "$worktree" '/docker-compose.agentgit.yaml'
    appendGitignoreEntry "$worktree" "/$CLONE_CONFIG_FILE"

    git -C "$DDEV_APPROOT" config extensions.worktreeConfig true
    git -C "$worktree" config --worktree gc.auto 0
    git -C "$worktree" config --worktree gc.worktreePruneExpire never
    git -C "$worktree" config --worktree maintenance.auto false
}

appendGitignoreEntry() {
    local worktree=$1 entry=$2
    local file="$worktree/.ddev/.gitignore"
    touch "$file"
    grep -qxF "$entry" "$file" 2>/dev/null || printf '%s\n' "$entry" >>"$file"
}

reportMigrationSkew() {
    local worktree=$1 migrationsPath=$2
    local record
    record=$(getMigrationsRecordFile)
    [ -f "$record" ] || return 0
    [ -d "$worktree/$migrationsPath" ] || return 0

    local branchList onlyInSnapshot onlyInBranch
    branchList=$( cd "$worktree/$migrationsPath" && ls -1 2>/dev/null || true )
    onlyInSnapshot=$(comm -23 <(sort "$record") <(printf '%s\n' "$branchList" | sort) | grep -c . || true)
    onlyInBranch=$(comm -13 <(sort "$record") <(printf '%s\n' "$branchList" | sort) | grep -c . || true)

    if [ "$onlyInSnapshot" -gt 0 ]; then
        warn "$onlyInSnapshot migration(s) were present when the golden snapshot was taken but are absent from this branch"
        warn "the clone's database is AHEAD of its code; doctrine:migrations:diff would invent duplicates"
    fi
    if [ "$onlyInBranch" -gt 0 ]; then
        warn "$onlyInBranch migration(s) exist on this branch but not when the snapshot was taken"
        warn "run your migration command inside the clone before relying on the schema"
    fi
}

