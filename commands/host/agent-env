validateSmokeConfig() {
    local json=$1 path status
    path=$(getSmokePath "$json")
    case "$path" in
        *://*|*[[:space:]]*)
            fail $EXIT_YAML "smoke_path '$path' is not a path; give a path such as /api/v1/health, not a URL"
            ;;
    esac

    for status in $(getSmokeStatuses "$json"); do
        [[ "$status" =~ ^[0-9]{3}$ ]] \
            || fail $EXIT_YAML "smoke_status '$status' is not a three-digit HTTP status code"
    done
}

joinSmokeUrl() {
    local url=$1 path=$2
    echo "${url%/}/${path#/}"
}

matchesSmokeStatus() {
    local status=$1 expected=$2 candidate
    for candidate in $expected; do
        if [ "$status" = "$candidate" ]; then
            return 0
        fi
    done
    return 1
}

describeSmokeHint() {
    local status=$1 redirect=$2 sourceHost
    sourceHost=$(getSourceHost)

    case "$redirect" in
        *"//$sourceHost"*)
            echo " — it redirects to the source project's hostname, so restored data still carries it (see post-restore-snapshot hooks)"
            return 0
            ;;
    esac

    case "$status" in
        5*) echo " — a 5xx is usually restored data still pointing at the source project's hostname (see post-restore-snapshot hooks)" ;;
        *) echo " — set smoke_path and smoke_status in .ddev/agent-env.yaml if this is not the right smoke test for this project" ;;
    esac
}

verifyClone() {
    local worktree=$1 started=$2 restored=$3 json=$4 fresh=$5 freshDeps=$6
    local skipped=""

    if [ "$started" = "yes" ]; then
        ( cd "$worktree" && ddev exec git rev-parse --git-dir >/dev/null 2>&1 ) \
            || fail $EXIT_VERIFY "git is not usable inside the clone's web container"
    else
        git -C "$worktree" rev-parse --git-dir >/dev/null 2>&1 \
            || fail $EXIT_VERIFY "git is not usable in the worktree"
    fi

    local missing="" groups="derived materialized" group relative
    [ "$freshDeps" != "yes" ] || groups="materialized"
    for group in $groups; do
        while IFS= read -r relative; do
            [ -n "$relative" ] || continue
            [ -e "$DDEV_APPROOT/$relative" ] || continue
            [ -e "$worktree/$relative" ] || missing="$missing $relative"
        done < <(queryConfig "$json" "copy_paths.$group")
    done
    [ -z "$missing" ] || fail $EXIT_VERIFY "declared paths are missing from the clone:$missing"

    if [ "$started" = "yes" ] && [ "$restored" = "yes" ]; then
        local url smokeUrl expected response status redirect
        url=$(getPrimaryUrl "$worktree")
        [ -n "$url" ] || fail $EXIT_VERIFY "could not read the clone's primary URL from ddev describe"

        smokeUrl=$(joinSmokeUrl "$url" "$(getSmokePath "$json")")
        expected=$(getSmokeStatuses "$json")
        response=$(curl -sk -o /dev/null -w '%{http_code} %{redirect_url}' "$smokeUrl" 2>/dev/null) || response="000 "
        status=${response%% *}
        redirect=${response#* }

        matchesSmokeStatus "$status" "$expected" \
            || fail $EXIT_VERIFY "$smokeUrl returned $status, expected ${expected// /, }$(describeSmokeHint "$status" "$redirect")"
    fi

    [ "$started" = "yes" ] || skipped="$skipped --no-start"
    [ "$fresh" != "yes" ] || skipped="$skipped --fresh"
    [ -z "$skipped" ] || info "verification skipped:$skipped — clone not smoke-tested"
}

