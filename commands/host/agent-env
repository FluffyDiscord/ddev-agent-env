getSnapshotFile() {
    local matches
    matches=("$(getSnapshotDir)/$GOLDEN_SNAPSHOT_NAME"-*)
    [ -e "${matches[0]}" ] || { echo ""; return 0; }
    echo "${matches[0]}"
