#ddev-generated
# Copy to .ddev/agent-env.yaml and edit. Paths are relative to the project root.
#
# Container-side work does NOT belong here. Use DDEV's own hooks in a tracked
# config.*.yaml — they support per-service tasks and fire on every restore,
# including ones agent-env never sees. See
# https://github.com/FluffyDiscord/ddev-agent-env/blob/master/docs/hooks-and-services.md

copy_paths:
  # Copied copy-on-write. create --fresh-deps skips them and reinstalls instead.
  derived:
    - vendor
    - node_modules
    - public/build

  # Nothing regenerates these. List files individually when the directory also
  # holds tracked files — the worktree checks those out first, and copying the
  # directory onto an existing one nests it (config/jwt/jwt/private.pem).
  materialized:
    - config/jwt/private.pem
    - config/jwt/public.pem
    - public/media

# Copied with the source's hostnames rewritten to the clone's.
env_rewrite_paths:
  - .env.local

# Keys in env_rewrite_paths set to REDACTED-IN-CLONE (create --with-secrets keeps them).
env_redact: []

# Filenames here are recorded with the golden snapshot; create warns when a
# clone's database and its code have drifted apart.
migrations_path: migrations

# The last step of create: request this path on the clone's URL and require this
# status. An API-only backend serves nothing at /, so point it at a route that
# answers — a 401 from an authenticated endpoint already proves PHP, routing and
# the restored database are alive:
#   smoke_path: /api/v1/widget/config
#   smoke_status: 401
# smoke_status also takes a list ([200, 302]) when more than one answer is fine.
smoke_path: /
smoke_status: 200

# Host commands, run in the clone's directory. Each list item is one command;
# use "- |" for a multi-line script.
hooks:
  post_worktree: []
  pre_remove: []

# Most clones running at once; create --force ignores it.
max_clones: 8
